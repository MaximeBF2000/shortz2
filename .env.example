# Copy to .env and fill in what you need. Everything is optional.

# A local Ollama model picks the clips (install Ollama, then `ollama pull <model>`).
# Set CLIP_FINDER=heuristic to skip AI entirely (picks clips by speaking pace).
CLIP_FINDER=ollama
OLLAMA_MODEL=qwen3.6:35b-mlx
# Context window in tokens. Longer transcripts are split into parts automatically.
OLLAMA_CONTEXT=32768
# Let the model think before answering: slower, better picks.
OLLAMA_THINK=true
# Where Ollama and the Shortz AI service (ai-server/) listen. Docker reaches them on the
# host through host.docker.internal automatically; only change these if you moved them.
# OLLAMA_URL=http://localhost:11434
# AI_SERVICE_URL=http://localhost:8765

# How many jobs the worker runs at once (processing + exports).
WORKER_CONCURRENCY=2

# Highest resolution downloaded from YouTube.
MAX_VIDEO_HEIGHT=1080

# If YouTube asks to "confirm you're not a bot", export your browser cookies
# (Netscape format), put the file in backend/ and set the path inside the container:
# YTDLP_COOKIES_FILE=/app/cookies.txt

# Where the browser reaches the app. Change both if you deploy on a server.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
