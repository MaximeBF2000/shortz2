# Copy to .env and fill in what you need. Everything is optional.

# Claude picks the clips. Without a key, a simple heuristic is used instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# faster-whisper model: tiny, base, small, medium, large-v3, turbo.
# Bigger is more accurate but slower. "small" is a good CPU default; use "turbo" on a GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# How many jobs the worker runs at once (processing + exports).
WORKER_CONCURRENCY=2

# Highest resolution downloaded from YouTube.
MAX_VIDEO_HEIGHT=1080

# If YouTube asks to "confirm you're not a bot", export your browser cookies
# (Netscape format), put the file in backend/ and set the path inside the container:
# YTDLP_COOKIES_FILE=/app/cookies.txt

# Where the browser reaches the app. Change both if you deploy on a server.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
